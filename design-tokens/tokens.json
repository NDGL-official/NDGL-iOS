      "orange": { "$value": "#FF6C11", "$extensions": { "ios": "DSKitAsset.Colors.etcOrange.color", "android": "NDGLTheme.colors.etcOrange" } },
      "purple": { "$value": "#5726E7", "$extensions": { "ios": "DSKitAsset.Colors.etcPurple.color", "android": "NDGLTheme.colors.etcPurple" } },
      "blue": {
        "$value": "#2960EC",
        "$extensions": {
          "status": "accepted",
          "decision": "Include etcBlue in the shared color palette.",
          "android": "NDGLTheme.colors.etcBlue"
        }
      }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "default": { "$type": "color", "$value": "{color.white}" },
        "surface": { "$type": "color", "$value": "{color.white}" },
        "subtle": { "$type": "color", "$value": "{color.black.50}" },
        "interactive": {
          "primary": { "$type": "color", "$value": "{color.black.900}" },
          "secondary": { "$type": "color", "$value": "{color.black.50}" },
          "destructive": { "$type": "color", "$value": "{color.red.50}" },
          "disabled": {
            "$type": "color",
            "$value": "{color.black.300}",
            "$extensions": {
              "status": "accepted",
              "decision": "Use the Figma baseline for disabled CTA background. Android should align from black100 to black300."
            }
          }
        }
      },
      "text": {
        "default": { "$type": "color", "$value": "{color.black.700}" },
        "subtle": { "$type": "color", "$value": "{color.black.500}" },
        "muted": { "$type": "color", "$value": "{color.black.400}" },
        "inverse": { "$type": "color", "$value": "{color.white}" },
        "interactive": {
          "primary": { "$type": "color", "$value": "{color.white}" },
          "secondary": { "$type": "color", "$value": "{color.black.700}" },
          "destructive": { "$type": "color", "$value": "{color.red.500}" },
          "disabled": {
            "$type": "color",
            "$value": "{color.black.400}",
            "$extensions": {
              "status": "accepted",
              "decision": "Use the Figma baseline for disabled CTA text and icon color. Android should align from black300 to black400."
            }
          }
        }
      },
      "icon": {
        "default": {
          "$type": "color",
          "$value": "{color.black.600}",
          "$extensions": {
            "figma": "color/icon/black_600",
            "status": "accepted",
            "decision": "Use color/icon/black_600 as the default 24px system icon color."
          }
        },
        "interactive": {
          "default": {
            "$type": "color",
            "$value": "{color.black.600}",
            "$extensions": {
              "figma": "color/icon/interactive/black_600"
            }
          },
          "disabled": {
            "$type": "color",
            "$value": "{semantic.color.text.interactive.disabled}"
          }
        }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.black.200}" },
        "interactive": { "$type": "color", "$value": "{color.black.200}" }
      },
      "brand": {
        "primary": { "$type": "color", "$value": "{color.green.500}" },
        "primarySubtle": { "$type": "color", "$value": "{color.green.50}" }
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$extensions": {
      "figmaAuthoring": {
        "rule": "Always apply existing Figma library Text Styles before manually setting font values.",
        "manualFontAssignment": "Exception only. If no matching Text Style exists, document the need and decide whether to add a new style."
      }
    },
    "fontFamily": {
      "pretendard": { "$type": "fontFamily", "$value": "Pretendard" }
    },
    "title": {
      "lg": {
        "bold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "32px", "fontWeight": 700, "lineHeight": "140%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Title/Lg/Bold", "ios": "UIFont.NDGL.titleLB", "android": "NDGLTheme.typography.titleLgBold" }
        },
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "32px", "fontWeight": 600, "lineHeight": "140%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Title/Lg/Semi Bold", "ios": "UIFont.NDGL.titleLSB", "android": "NDGLTheme.typography.titleLgSemiBold" }
        }
      },
      "md": {
        "bold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "22px", "fontWeight": 700, "lineHeight": "140%", "letterSpacing": "-2%" },
          "$extensions": { "figma": "Title/Md/Bold", "ios": "UIFont.NDGL.titleMB", "android": "NDGLTheme.typography.titleMdBold" }
        },
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "22px", "fontWeight": 600, "lineHeight": "140%", "letterSpacing": "-2%" },
          "$extensions": { "figma": "Title/Md/Semi Bold", "ios": "UIFont.NDGL.titleMSB", "android": "NDGLTheme.typography.titleMdSemiBold" }
        }
      }
    },
    "subtitle": {
      "lg": {
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "20px", "fontWeight": 600, "lineHeight": "140%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Subtitle/Lg/Semi Bold", "ios": "UIFont.NDGL.subTitleLSB", "android": "NDGLTheme.typography.subtitleLgSemiBold" }
        },
        "medium": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "20px", "fontWeight": 500, "lineHeight": "140%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Subtitle/Lg/Medium", "ios": "UIFont.NDGL.subTitleLM", "android": "NDGLTheme.typography.subtitleLgMedium" }
        }
      },
      "md": {
        "bold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "18px", "fontWeight": 700, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Subtitle/Md/Bold", "ios": "UIFont.NDGL.subTitleMB", "android": "NDGLTheme.typography.subtitleMdBold" }
        },
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "18px", "fontWeight": 600, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Subtitle/Md/Semi Bold", "ios": "UIFont.NDGL.subTitleMSB", "android": "NDGLTheme.typography.subtitleMdSemiBold" }
        },
        "medium": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "18px", "fontWeight": 500, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Subtitle/Md/Medium", "ios": "UIFont.NDGL.subTitleMM", "android": "NDGLTheme.typography.subtitleMdMedium" }
        }
      }
    },
    "body": {
      "lg": {
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "16px", "fontWeight": 600, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Lg/Semi Bold", "ios": "UIFont.NDGL.bodyLSB", "android": "NDGLTheme.typography.bodyLgSemiBold" }
        },
        "medium": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Lg/Medium", "ios": "UIFont.NDGL.bodyLM", "android": "NDGLTheme.typography.bodyLgMedium" }
        },
        "regular": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Lg/Regular", "ios": "UIFont.NDGL.bodyLR", "android": "NDGLTheme.typography.bodyLgRegular" }
        }
      },
      "md": {
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "14px", "fontWeight": 600, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Md/Semi Bold", "ios": "UIFont.NDGL.bodyMSB", "android": "NDGLTheme.typography.bodyMdSemiBold" }
        },
        "medium": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "14px", "fontWeight": 500, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Md/Medium", "ios": "UIFont.NDGL.bodyMM", "android": "NDGLTheme.typography.bodyMdMedium" }
        },
        "regular": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Md/Regular", "ios": "UIFont.NDGL.bodyMR", "android": "NDGLTheme.typography.bodyMdRegular" }
        }
      },
      "sm": {
        "semibold": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "12px", "fontWeight": 600, "lineHeight": "120%", "letterSpacing": "-1%" },
          "$extensions": { "figma": "Body/Sm/Semi Bold", "ios": "UIFont.NDGL.bodySSB", "android": "NDGLTheme.typography.bodySmSemiBold" }
        },
        "medium": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Sm/Medium", "ios": "UIFont.NDGL.bodySM", "android": "NDGLTheme.typography.bodySmMedium" }
        },
        "regular": {
          "$value": { "fontFamily": "{typography.fontFamily.pretendard}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "130%", "letterSpacing": "-2.5%" },
          "$extensions": { "figma": "Body/Sm/Regular", "ios": "UIFont.NDGL.bodySR", "android": "NDGLTheme.typography.bodySmRegular" }
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "40": { "$value": "40px" },
    "48": { "$value": "48px" },
    "56": { "$value": "56px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "lg": { "$value": "8px", "$extensions": { "figma": ["border/radius/lg", "border/radius/8_lg"] } },
    "rounded": { "$value": "999px", "$extensions": { "figma": ["border/radius/rounded"] } }
  },
  "component": {
    "button": {
      "cta": {
        "type": {
          "primary": {
            "bg": { "$type": "color", "$value": "{semantic.color.bg.interactive.primary}" },
            "fg": { "$type": "color", "$value": "{semantic.color.text.interactive.primary}" }
          },
          "secondary": {
            "bg": { "$type": "color", "$value": "{semantic.color.bg.interactive.secondary}" },
            "fg": { "$type": "color", "$value": "{semantic.color.text.interactive.secondary}" }
          },
          "destructive": {
            "$extensions": {
              "figmaLegacyAlias": "Danger"
            },
            "bg": { "$type": "color", "$value": "{semantic.color.bg.interactive.destructive}" },
            "fg": { "$type": "color", "$value": "{semantic.color.text.interactive.destructive}" }
          },
          "disabled": {
            "bg": { "$type": "color", "$value": "{semantic.color.bg.interactive.disabled}" },
            "fg": { "$type": "color", "$value": "{semantic.color.text.interactive.disabled}" }
          }
        },
        "size": {
          "large": {
            "height": { "$type": "dimension", "$value": "{spacing.56}" },
            "paddingX": { "$type": "dimension", "$value": "{spacing.24}" },
            "paddingY": { "$type": "dimension", "$value": "{spacing.8}" },
            "gap": { "$type": "dimension", "$value": "{spacing.8}" },
            "icon": { "$type": "dimension", "$value": "{spacing.24}" },
            "text": { "$type": "typography", "$value": "{typography.body.lg.semibold}" }
          },
          "medium": {
            "height": { "$type": "dimension", "$value": "{spacing.40}" },
            "paddingX": {
              "$type": "dimension",
              "$value": "{spacing.16}",
              "$extensions": {
                "status": "accepted",
                "decision": "Use 16px as the shared medium CTA horizontal padding. Android should align from 24dp to 16dp. iOS should make this explicit if needed."
              }
            },
            "paddingY": { "$type": "dimension", "$value": "{spacing.8}" },
            "gap": { "$type": "dimension", "$value": "{spacing.8}" },
            "icon": { "$type": "dimension", "$value": "{spacing.20}" },
            "text": { "$type": "typography", "$value": "{typography.body.md.semibold}" }
          },
          "small": {
            "height": {
              "$type": "dimension",
              "$value": "30px",
              "$extensions": {
                "status": "accepted",
                "decision": "Use 30px for CTA small height. Small icon buttons use a separate 32px token."
              }
            },
            "paddingX": { "$type": "dimension", "$value": "{spacing.12}" },
            "paddingY": { "$type": "dimension", "$value": "{spacing.8}" },
            "gap": { "$type": "dimension", "$value": "{spacing.4}" },
            "icon": { "$type": "dimension", "$value": "{spacing.16}" },
            "text": { "$type": "typography", "$value": "{typography.body.sm.semibold}" }
          }
        },
        "radius": { "$type": "dimension", "$value": "{radius.lg}" },
        "outline": {
          "borderColor": { "$type": "color", "$value": "{semantic.color.border.interactive}" },
          "borderWidth": { "$type": "dimension", "$value": "1px" },
          "$extensions": {
            "status": "accepted",
            "decision": "Treat outline as button.cta.outline in shared tokens. Android may implement it through a separate outlined button component.",
            "androidImplementation": "NDGLOutlinedButton"
          }
        }
      },
      "icon": {
        "size": {
          "small": {
            "$type": "dimension",
            "$value": "32px",
            "$extensions": {
              "status": "accepted",
              "decision": "Use 32px for small icon buttons."
            }
          }
        }
      }
    },
    "icon": {
      "system": {
        "size": {
          "base": {
            "$type": "dimension",
            "$value": "{spacing.24}",
            "$extensions": {
              "figma": "24px icon components such as ic_x/x, ic_asterisk, and ic_ic_arrow=arrow-up-right"
            }
          }
        },
        "color": {
          "$type": "color",
          "$value": "{semantic.color.icon.default}"
        }
      }
    },
    "toast": {
      "width": { "$type": "dimension", "$value": "327px" },
      "height": { "$type": "dimension", "$value": "46px" },
      "label": {
        "$type": "typography",
        "$value": "{typography.body.md.semibold}"
      },
      "$extensions": {
        "figma": {
          "componentSet": "toast",
          "variants": ["AddTravel", "Delete", "Transport", "Edit", "Common"],
          "properties": {
            "Type": "Use fixed variants for known toast messages. Use Type=Common for custom copy.",
            "Label": "Editable only on Type=Common.",
            "Btn": "Controls optional CTA visibility."
          }
        }
      }
    }
  }
}
