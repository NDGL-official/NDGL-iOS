      "700": { "$value": "#0C7F1D", "$extensions": { "ios": "DSKitAsset.Colors.green700.color", "android": "NDGLTheme.colors.green700" } },
      "800": { "$value": "#085C15", "$extensions": { "ios": "DSKitAsset.Colors.green800.color", "android": "NDGLTheme.colors.green800" } },
